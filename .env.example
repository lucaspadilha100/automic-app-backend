# =====================================================================
# AutomIQ Booking Backend - Environment Variables
# =====================================================================
# Copy this file to .env and fill in the values before running.

# ---- Application ----
PROJECT_NAME=AutomIQ Booking Backend
ENVIRONMENT=development
# development | staging | production

# ---- Database ----
DATABASE_URL=postgresql://automiq:automiq@localhost:5432/automiq_db

# ---- Security ----
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
# Extra origins allowed by regex, checked on top of the list above. The default
# already covers localhost and every *.vercel.app domain — only override it to
# add a custom domain, e.g.:
# BACKEND_CORS_ORIGIN_REGEX=^https://([a-zA-Z0-9-]+\.)*vercel\.app$|^https://([a-zA-Z0-9-]+\.)*automic\.tech\.com\.br$

# ---- First Super Admin ----
FIRST_SUPER_ADMIN_EMAIL=admin@automiq.com.br
FIRST_SUPER_ADMIN_PASSWORD=AutomIQ@2024!
FIRST_SUPER_ADMIN_NAME=Super Admin

# ---- Timezone ----
DEFAULT_TIMEZONE=America/Sao_Paulo

# ---- Uploads / Storage ----
UPLOAD_STORAGE=local
# local | s3 | r2
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ---- Rate Limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5

# ---- Webhooks ----
WEBHOOKS_ENABLED=false

# ---- Debug ----
DEBUG=false
LOG_LEVEL=INFO
